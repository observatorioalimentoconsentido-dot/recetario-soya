rules_version = '2';

// Reglas de seguridad de la base de datos.
// Copia TODO este archivo en: Consola de Firebase -> Firestore Database -> pestaña "Reglas" -> Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Es administrador quien tiene sesión Y existe un documento admins/<su uid>.
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cada usuario solo puede consultar su propio documento (para saber si es admin).
    // Nadie puede crear administradores desde la página: se crean a mano en la consola.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Recetas: todos las ven; solo el administrador crea, edita y borra.
    match /recetas/{receta} {
      allow read: if true;
      allow create: if esAdmin() && recetaValida(request.resource.data)
        && request.resource.data.fecha == request.time;
      allow update: if esAdmin() && recetaValida(request.resource.data)
        && request.resource.data.fecha == resource.data.fecha;
      allow delete: if esAdmin();
    }

    // Videos de YouTube: todos los ven; solo el administrador agrega, edita y borra.
    match /videos/{video} {
      allow read: if true;
      allow create: if esAdmin() && videoValido(request.resource.data)
        && request.resource.data.fecha == request.time;
      allow update: if esAdmin() && videoValido(request.resource.data)
        && request.resource.data.fecha == resource.data.fecha;
      allow delete: if esAdmin();
    }

    // Propuestas de visitantes: cualquiera puede ENVIAR una, pero solo el administrador puede
    // verlas, aprobarlas o borrarlas. Nada de aquí se muestra en la página.
    match /pendientes/{propuesta} {
      allow create: if pendienteValida(request.resource.data);
      allow read, delete: if esAdmin();
      allow update: if false;
    }

    // Propuestas de video de visitantes: cualquiera envía, solo el administrador lee y borra.
    match /videosPendientes/{propuesta} {
      allow create: if videoPendienteValido(request.resource.data);
      allow read, delete: if esAdmin();
      allow update: if false;
    }

    function videoPendienteValido(v) {
      return v.keys().hasOnly(['titulo', 'ytId', 'descripcion', 'autor', 'fecha'])
        && v.keys().hasAll(['titulo', 'ytId', 'descripcion', 'autor', 'fecha'])
        && v.titulo is string && v.titulo.size() >= 3 && v.titulo.size() <= 100
        && v.ytId is string && v.ytId.size() == 11
        && (v.descripcion == null || (v.descripcion is string && v.descripcion.size() <= 200))
        && (v.autor == null || (v.autor is string && v.autor.size() >= 1 && v.autor.size() <= 60))
        && v.fecha == request.time;
    }

    function videoValido(v) {
      return v.keys().hasOnly(['titulo', 'ytId', 'descripcion', 'fecha'])
        && v.keys().hasAll(['titulo', 'ytId', 'descripcion', 'fecha'])
        && v.titulo is string && v.titulo.size() >= 3 && v.titulo.size() <= 100
        && v.ytId is string && v.ytId.size() == 11
        && (v.descripcion == null || (v.descripcion is string && v.descripcion.size() <= 200))
        && v.fecha is timestamp;
    }

    function pendienteValida(r) {
      return r.keys().hasOnly(['nombre', 'descripcion', 'coccion', 'tiempo', 'ingredientes', 'preparacion', 'nota', 'autor', 'fecha'])
        && r.keys().hasAll(['nombre', 'descripcion', 'coccion', 'tiempo', 'ingredientes', 'preparacion', 'nota', 'autor', 'fecha'])
        && r.nombre is string && r.nombre.size() >= 3 && r.nombre.size() <= 80
        && r.descripcion is string && r.descripcion.size() >= 1 && r.descripcion.size() <= 200
        && r.coccion is string && r.coccion.size() >= 1 && r.coccion.size() <= 80
        && r.tiempo is string && r.tiempo.size() >= 1 && r.tiempo.size() <= 80
        && r.ingredientes is list && r.ingredientes.size() >= 1 && r.ingredientes.size() <= 40
        && r.preparacion is list && r.preparacion.size() >= 1 && r.preparacion.size() <= 30
        && (r.nota == null || (r.nota is string && r.nota.size() <= 400))
        && (r.autor == null || (r.autor is string && r.autor.size() >= 1 && r.autor.size() <= 60))
        && r.fecha == request.time;
    }

    function recetaValida(r) {
      return r.keys().hasOnly(['nombre', 'descripcion', 'coccion', 'tiempo', 'ingredientes', 'preparacion', 'nota', 'autor', 'imagen', 'miniatura', 'fecha'])
        && r.keys().hasAll(['nombre', 'descripcion', 'coccion', 'tiempo', 'ingredientes', 'preparacion', 'nota', 'autor', 'fecha'])
        && r.nombre is string && r.nombre.size() >= 3 && r.nombre.size() <= 80
        && r.descripcion is string && r.descripcion.size() >= 1 && r.descripcion.size() <= 200
        && r.coccion is string && r.coccion.size() >= 1 && r.coccion.size() <= 80
        && r.tiempo is string && r.tiempo.size() >= 1 && r.tiempo.size() <= 80
        && r.ingredientes is list && r.ingredientes.size() >= 1 && r.ingredientes.size() <= 40
        && r.preparacion is list && r.preparacion.size() >= 1 && r.preparacion.size() <= 30
        && (r.nota == null || (r.nota is string && r.nota.size() <= 400))
        && (r.autor == null || (r.autor is string && r.autor.size() >= 1 && r.autor.size() <= 60))
        && (!('imagen' in r) || r.imagen == null || (r.imagen is string && r.imagen.size() <= 350000))
        && (!('miniatura' in r) || r.miniatura == null || (r.miniatura is string && r.miniatura.size() <= 40000))
        && r.fecha is timestamp;
    }

    // Foto grande de cada receta (mismo id que la receta). Se puede leer una por una, pero no listar todas.
    match /imagenes/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if esAdmin() && request.resource.data.keys().hasOnly(['datos'])
        && request.resource.data.datos is string && request.resource.data.datos.size() <= 350000;
      allow delete: if esAdmin();
    }
  }
}
